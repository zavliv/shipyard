MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shipyard


# How the panel reaches vpsctl: "ssh" from your Mac during development, "local" on the server.
VPSCTL_MODE=ssh
VPSCTL_SSH_HOST=user@your-server-ip
VPSCTL_SSH_PORT=22

ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# GitHub App used to list repositories and clone them (see README: Connect GitHub)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=

# Key for encrypting settings while jobs wait in the queue (openssl rand -base64 32)
SHIPYARD_SECRET=

# Secret shared with the GitHub App webhook (auto-deploy on push)
GITHUB_WEBHOOK_SECRET=

# Optional: Hostinger API token and server ID for weekly server snapshots
HOSTINGER_API_TOKEN=
HOSTINGER_VM_ID=

# Your panel's public address, used in email links (no trailing slash)
PANEL_URL=https://panel.example.com
# GitHub repository that "Update Shipyard" downloads from (owner/name)
UPDATE_REPO=
# Optional: this server's public IP. Detected automatically when empty.
SERVER_IP=

# Display settings, applied at build time (rebuild after changing)
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_LOCALE=en-GB
# Optional: a domain whose *.subdomains already point to this server, used in form hints
NEXT_PUBLIC_WILDCARD_DOMAIN=
