{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --conditions=react-server --outfile=dist/worker.mjs",
    "worker": "node --conditions=react-server dist/worker.mjs",
    "dev:worker": "tsx watch --conditions=react-server src/worker/index.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.52.0",
    "mongodb": "^6.22.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
